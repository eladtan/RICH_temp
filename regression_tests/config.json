{
  "schema_version": 1,
  "description": "RICH, embedded STORM, and MadVoro regression tests",
  "project_root": "..",
  "artifact_root": "regression_results",
  "test_categories": ["physics", "code_correctness"],
  "discovery": {
    "metadata": "REGRESSION_INFO",
    "test_roots": [
      {
        "path": "regression_tests/cases",
        "namespace": "rich"
      }
    ]
  },
  "subprojects": [
    {
      "name": "storm",
      "config": "source/monte/regression_tests/config.json",
      "option_overrides": {
        "deps_dir": "{project_root}/source/utils",
        "madvoro_dir": "{project_root}/source/3D/tessellation/voronoi",
        "madcart_dir": "{project_root}/source/3D/tessellation/cartesian",
        "mesh_decomposer_dir": "{project_root}/source/3D/tessellation/MeshDecomposer3D"
      }
    },
    {
      "name": "madvoro",
      "config": "source/3D/tessellation/voronoi/regression_tests/config.json",
      "option_overrides": {
        "deps_dir": "{project_root}/source/utils",
        "mesh_decomposer_dir": "{project_root}/source/3D/tessellation/MeshDecomposer3D"
      }
    }
  ],
  "builds": {
    "rich": {
      "mode": "grouped",
      "build_dir": "build",
      "configure_command": [
        "cmake",
        "-S",
        "{project_root}/source",
        "-B",
        "{build_dir}",
        "-DCONFIG={config}",
        "-DTEST_DIR={build_test_name}",
        "-DCMAKE_RUNTIME_OUTPUT_DIRECTORY={build_dir}",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "build_command": [
        "cmake",
        "--build",
        "{build_dir}",
        "-j",
        "{nproc}"
      ],
      "target": "rich_{config}",
      "binary": "{build_dir}/rich_{config}",
      "argument_cmake": {
        "--with_asan": "ASAN=1",
        "--energy_groups_num": "ENERGY_GROUPS_NUM={value}",
        "--debug_files": "DEBUG_FILES={value}",
        "--mc_debug": "MC_DEBUG=1",
        "--mc_trace_debug": "MC_TRACE_DEBUG={value}",
        "--shared": "DYNAMIC_LIBS=1",
        "--high-res": "HIGH_RES=1",
        "--memory_debug": "MEMORY_DEBUG=1",
        "--memory_profile": "MEMORY_PROFILE=1",
        "--assert": "FORCE_ASSERT=1",
        "--timing": "TIMING=1",
        "--montecarlo-polarization": "RICH_MONTECARLO_POLARIZATION=ON"
      }
    }
  },
  "runs": {
    "rich": {
      "mode": "slurm",
      "force_slurm": true,
      "binary_environment": "RICH_BIN",
      "timeout": 7200,
      "tasks": 1
    }
  },
  "checks": {
    "library": "regression_tests/lib/regression_checks.sh"
  },
  "defaults": {
    "mode": "serial"
  },
  "mode_profiles": {
    "serial": "{compiler}{build_type}",
    "mpi": "{compiler}{build_type}MPI",
    "all": "{compiler}{build_type}MPI"
  },
  "options": [
    {
      "flags": [
        "--compiler"
      ],
      "dest": "compiler",
      "type": "enum",
      "choices": ["gnu", "intel"],
      "default": "gnu",
      "help": "Compiler family"
    },
    {
      "flags": [
        "--build-type"
      ],
      "dest": "build_type",
      "type": "enum",
      "choices": ["Release", "Debug", "Mixed"],
      "default": "Release",
      "help": "Build type (Release, Debug, or Mixed)"
    }
  ],
  "environment": {
    "ROOT_DIR": "{project_root}",
    "CONFIG": "{config}"
  }
}
