{
  "schema_version": 1,
  "description": "RICH and embedded STORM regression tests",
  "project_root": "..",
  "artifact_root": "regression_results",
  "discovery": {
    "metadata": "REGRESSION_INFO",
    "test_roots": [
      {
        "path": "regression_tests/cases",
        "namespace": "rich"
      }
    ]
  },
  "subprojects": [
    {
      "name": "storm",
      "config": "source/monte/regression_tests/config.json"
    }
  ],
  "builds": {
    "rich": {
      "mode": "per_test",
      "build_dir": "build",
      "command": [
        "{project_root}/build_rich.sh",
        "{config}",
        "--test_name={build_test_name}",
        "--build-subdir={build_id}",
        "--jobs={nproc}"
      ],
      "binary": "{project_root}/build/{config}/{build_id}/rich"
    }
  },
  "runs": {
    "rich": {
      "mode": "slurm",
      "force_slurm": true,
      "binary_environment": "RICH_BIN",
      "timeout": 7200,
      "tasks": 1
    }
  },
  "checks": {
    "library": "regression_tests/lib/regression_checks.sh"
  },
  "defaults": {
    "mode": "serial"
  },
  "mode_profiles": {
    "serial": "gnuRelease",
    "mpi": "gnuReleaseMPI",
    "all": "gnuReleaseMPI"
  },
  "options": [
    {
      "flags": [
        "--config"
      ],
      "dest": "config",
      "type": "enum",
      "choices": [
        "gnuRelease",
        "gnuDebug",
        "gnuReleaseMPI",
        "gnuDebugMPI",
        "intelRelease",
        "intelDebug",
        "intelReleaseMPI",
        "intelDebugMPI",
        "gnuMixedMPI",
        "intelMixedMPI"
      ],
      "default": null,
      "help": "RICH build profile used by build_rich.sh"
    }
  ],
  "environment": {
    "ROOT_DIR": "{project_root}",
    "CONFIG": "{config}"
  }
}
