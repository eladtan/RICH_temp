{
  "schema_version": 1,
  "description": "RICH and embedded STORM regression tests",
  "project_root": "..",
  "artifact_root": "regression_results",
  "discovery": {
    "metadata": "REGRESSION_INFO",
    "test_roots": [
      {
        "path": "regression_tests/cases",
        "namespace": "rich"
      }
    ]
  },
  "subprojects": [
    {
      "name": "storm",
      "config": "source/monte/regression_tests/config.json"
    }
  ],
  "builds": {
    "rich": {
      "mode": "per_test",
      "build_dir": "build",
      "command": [
        "{project_root}/build_rich.sh",
        "{config}",
        "--test_name={build_test_name}",
        "--build-subdir={build_id}",
        "--jobs={nproc}"
      ],
      "binary": "{project_root}/build/{config}/{build_id}/rich"
    }
  },
  "runs": {
    "rich": {
      "mode": "slurm",
      "force_slurm": true,
      "binary_environment": "RICH_BIN",
      "timeout": 7200,
      "tasks": 1
    }
  },
  "checks": {
    "library": "regression_tests/lib/regression_checks.sh"
  },
  "defaults": {
    "mode": "serial"
  },
  "mode_profiles": {
    "serial": "{compiler}{build_type}",
    "mpi": "{compiler}{build_type}MPI",
    "all": "{compiler}{build_type}MPI"
  },
  "options": [
    {
      "flags": [
        "--compiler"
      ],
      "dest": "compiler",
      "type": "enum",
      "choices": ["gnu", "intel"],
      "default": "gnu",
      "help": "Compiler family"
    },
    {
      "flags": [
        "--build-type"
      ],
      "dest": "build_type",
      "type": "enum",
      "choices": ["Release", "Debug", "Mixed"],
      "default": "Release",
      "help": "Build type (Release, Debug, or Mixed)"
    }
  ],
  "environment": {
    "ROOT_DIR": "{project_root}",
    "CONFIG": "{config}"
  }
}
