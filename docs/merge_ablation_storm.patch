+        entry.sourceCellID = sourceCellID;
+        entry.targetCellID = targetCellID;
+        entry.group = group;
+        entry.sourceGroupCutoff = sourceGroupCutoff;
+        entry.targetGroupCutoff = targetGroupCutoff;
+        entry.faceX = this->grid.FaceCM(faceIndex)[0];
