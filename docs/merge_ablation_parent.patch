@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+
+TEST_ID="fmm_gravity_serial"
+TAGS="serial"
+BUILD_TEST_NAME="regression_tests/cases/fmm_gravity_serial"
+RUN_DIR_REL="regression_tests/cases/fmm_gravity_serial"
