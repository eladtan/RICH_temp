+    voronoi_error=$(awk '$1 == "max_voronoi_area_rel_error" { print $2 }' "$metrics_file")
+    omega_error=$(awk '$1 == "solid_angle_rel_error" { print $2 }' "$metrics_file")
+    pass_flag=$(awk '$1 == "pass" { print $2 }' "$metrics_file")
