index 0000000000000000000000000000000000000000..50b6cde0074476128104f176730bf58cf856cf1f
--- /dev/null
+++ b/source/3D/radiation/postprocess/ForwardCalculation.cpp
@@ -0,0 +1,765 @@
+#include "ForwardCalculation.hpp"
+
+#include <algorithm>
