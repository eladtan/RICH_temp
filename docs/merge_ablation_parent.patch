diff --git a/regression_tests/cases/fmm_peer_exchange_rebuild/test.cpp b/regression_tests/cases/fmm_peer_exchange_rebuild/test.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..de1691d1fea8707341c0e4f8a4826d7e155669b8
