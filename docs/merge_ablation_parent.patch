+
+bool sphericalCircumcenter(Vector3D const& a,
+                           Vector3D const& b,
+                           Vector3D const& c,
+                           Vector3D& center)
+{
+    center = CrossProduct(b - a, c - a);
+    double const norm = abs(center);
+    if (!(norm > 0.0) || !std::isfinite(norm))
+        return false;
+    center *= 1.0 / norm;
