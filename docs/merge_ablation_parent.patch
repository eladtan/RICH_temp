+double sphericalTriangleArea(Vector3D const& a,
+                             Vector3D const& b,
+                             Vector3D const& c)
+{
+    double const numerator = std::abs(ScalarProd(a, CrossProduct(b, c)));
+    double const denominator = 1.0 + ScalarProd(a, b)
+                                   + ScalarProd(b, c)
+                                   + ScalarProd(c, a);
+    return 2.0 * std::atan2(numerator, denominator);
