+    if [[ -z "$pure_fourth" || -z "$mixed_fourth" ||
+          -z "$chi_square" || -z "$voronoi_error" ||
+          -z "$omega_error" || -z "$pass_flag" ]]; then
+        set_check_msg "failed to parse radiation direction sampling metrics"
+        return 1
