+    MPI_Reduce(localExchangeBytes, maximumExchangeBytes, 3,
+               MPI_UNSIGNED_LONG_LONG, MPI_MAX, 0, MPI_COMM_WORLD);
+    for(int i = 0; i < 22; ++i)
+        meanTimes[i] /= static_cast<double>(stats.mpiRankCount);
+#else
