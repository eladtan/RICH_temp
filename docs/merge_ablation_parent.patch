+    // The outward hull normal is the spherical Delaunay circumcenter.
+    if (ScalarProd(center, a + b + c) < 0.0)
+        center *= -1.0;
+    return std::isfinite(center.x) && std::isfinite(center.y)
+        && std::isfinite(center.z);
