--- a/tests/cpu_intersection_test.cpp
+++ b/tests/cpu_intersection_test.cpp
@@ -0,0 +1,145 @@
+// Differential oracle: the original scalar face walk, kept independent of the
+// vector implementation. Exact equality includes face-order tie breaking.
+#include "gpu/FlatGridView.hpp"
+#include <algorithm>
+#include <cfenv>
+#include <cmath>
+#include <iostream>
+#include <random>
+#include <stdexcept>
+#include <vector>
+namespace STORM {
+namespace gpu {
+template <typename ParticleT, typename PointT>
+STORM_GPU_INLINE_FUNCTION Intersection
+ReferenceIntersection(const ParticleT &particle,
+                      const FlatGridView<PointT> &grid, const double speed) {
+  Intersection result;
+  const std::size_t cellIndex = static_cast<std::size_t>(particle.cellIndex);
+  if (cellIndex >= grid.cellCount) {
+    return result;
+  }
+  // A direction parallel to the slab has no axial intersection. It still
+  // has a valid scattering/census event, possibly at DBL_MAX face time.
+  result.valid = grid.slabTransport;
+
+  const double velocityTolerance = 1.0e-12 * speed;
+  const std::size_t begin = grid.cellFaceOffsets[cellIndex];
+  const std::size_t end = grid.cellFaceOffsets[cellIndex + 1];
+
+  for (std::size_t directedFace = begin; directedFace < end; ++directedFace) {
+    const PointT &normal = grid.normals[directedFace];
+    if (grid.slabTransport && normal.x == 0.0) {
+      continue;
+    }
+    const double normalVelocity = normal.x * particle.velocity.x +
+                                  normal.y * particle.velocity.y +
+                                  normal.z * particle.velocity.z;
+    if (normalVelocity >= -velocityTolerance) {
+      continue;
+    }
+
+    const double locationPlane = particle.location.x * normal.x +
+                                 particle.location.y * normal.y +
+                                 particle.location.z * normal.z;
+    const double time =
+        (grid.facePlaneOffsets[directedFace] - locationPlane) / normalVelocity;
+    if (time > 0.0 && time < result.time) {
+      result.time = time;
+      result.nextCellIndex = grid.nextCellIndices[directedFace];
+      result.directedFace = directedFace;
+      result.boundaryCrossing = grid.boundaryCrossings[directedFace];
+      result.valid = 1;
+    }
+  }
+  return result;
+}
+
+} // namespace gpu
+} // namespace STORM
+
+struct V {
+  double x, y, z;
+};
+struct P {
+  V location, velocity;
+  STORM::cell_index_t cellIndex;
+};
+int main() {
+  std::mt19937_64 rng(120921);
+  std::uniform_real_distribution<double> u(-1, 1);
+  size_t count = 0;
+  for (size_t faces = 1; faces <= 40; ++faces)
+    for (size_t offset = 0; offset < 4; ++offset) {
+      std::vector<V> normals(offset + faces);
+      std::vector<double> planes(offset + faces);
+      std::vector<STORM::cell_index_t> next(offset + faces);
+      std::vector<uint8_t> boundary(offset + faces);
+      size_t offsets[] = {offset, offset + faces};
+      STORM::gpu::FlatGridView<V> grid;
+      grid.cellCount = 1;
+      grid.cellFaceOffsets = offsets;
+      grid.normals = normals.data();
+      grid.facePlaneOffsets = planes.data();
+      grid.nextCellIndices = next.data();
+      grid.boundaryCrossings = boundary.data();
+      for (size_t i = 0; i < normals.size(); ++i) {
+        normals[i] = {u(rng), u(rng), u(rng)};
+        planes[i] = -1 - std::abs(u(rng));
+        next[i] = i + 1;
+        boundary[i] = i % 2;
+      }
+      for (size_t test = 0; test < 5000; ++test) {
+        if (test % 100 == 0)
+          for (size_t i = 0; i < normals.size(); ++i) {
+            if (test % 200 == 0) {
+              normals[i] = {double(i % 6 == 0) - double(i % 6 == 1),
+                            double(i % 6 == 2) - double(i % 6 == 3),
+                            double(i % 6 == 4) - double(i % 6 == 5)};
+              planes[i] = -1;
+            } else {
+              normals[i] = {u(rng), u(rng), u(rng)};
+              planes[i] = -1 - std::abs(u(rng));
+            }
+          }
+        P p{{u(rng) * .5, u(rng) * .5, u(rng) * .5},
+            {u(rng), u(rng), u(rng)},
+            0};
+        switch (test % 10) {
+        case 0:
+          p.location = {0, 0, 0};
+          p.velocity = {1, 1, 1};
+          break; // exact corner ties, including repeated faces
+        case 1:
+          p.velocity = {1, 0, 0};
+          break; // parallel faces
+        case 2:
+          p.location = {-1, 0, 0};
+          break; // starts on plane
+        case 3:
+          p.velocity = {0, 0, 0};
+          break;
+        case 4:
+          p.velocity = {1, 1e-12, 1e-13};
+          break; // grazing threshold
+        }
+        grid.slabTransport = test % 3 == 0;
+        double speed = std::sqrt(p.velocity.x * p.velocity.x +
+                                 p.velocity.y * p.velocity.y +
+                                 p.velocity.z * p.velocity.z);
+        auto a = STORM::gpu::ReferenceIntersection(p, grid, speed);
+        std::feclearexcept(FE_ALL_EXCEPT);
+        auto b = STORM::gpu::FindIntersection(p, grid, speed);
+        if (std::fetestexcept(FE_INVALID | FE_DIVBYZERO))
+          throw std::runtime_error("floating-point exception");
+        if (a.time != b.time || a.nextCellIndex != b.nextCellIndex ||
+            a.directedFace != b.directedFace ||
+            a.boundaryCrossing != b.boundaryCrossing || a.valid != b.valid)
+          throw std::runtime_error("intersection mismatch");
+        ++count;
+      }
+    }
+  std::cout << "PASS: " << count
+            << " scalar/vector intersections match exactly; ties, tails, slab, "
+               "parallel and grazing directions\n";
+}
