+        require(size == 2, "test requires two ranks");
+        RDMA_Type backend = argc > 1 && std::string(argv[1]) == "ofi" ? RDMA_Type::OFI_RDMA : RDMA_Type::MPI_RMA;
+        RMAFactory::Initialize(backend, MPI_COMM_WORLD);
+        {
+            auto realloc = std::make_shared<STORM::ReallocationAgent>(MPI_COMM_WORLD, [](rank_t) {
+                throw std::runtime_error("unexpected reallocation request during transport");
+            });
+            Handler handler(7, MPI_COMM_WORLD, MPI_COMM_WORLD, realloc, backend, 1);
+            for(size_t epoch = 0; epoch < 12; ++epoch) {
+                if(epoch != 0) {
+                    // Alternate replacement with growth and shrinking. Both
+                    // peers participate only after the previous global drain.
+                    const size_t capacity = epoch % 2 ? 19 : 5;
+                    handler.requestedFactor = static_cast<double>(capacity) / handler.buffsize;
+                    handler.Reallocate(handler.requestedFactor);
+                }
+                handler.Reset();
+                MPI_Barrier(MPI_COMM_WORLD);
+                handler.BeginFixedStep();
+                MPI_Barrier(MPI_COMM_WORLD);
+                rejects([&] { handler.Reset(); });
+                rejects([&] { handler.Destroy(); });
+                rejects([&] { handler.Reallocate(2); });
+                rejects([&] { handler.LocalReallocate(2); });
+                rejects([&] { handler.UpdatePeerRemoteInfo({}); });
+                Packet one;
+                rejects([&] { handler.AppendLocalParticles(&one, 1); });
+                rejects([&] { handler.TransferParticles(&one, 1); });
+
+                constexpr size_t count = 511;
+                STORM::RegisteredSendBuffer<Packet, Handler> outgoing;
+                for(size_t i = 0; i < count; ++i) {
+                    Packet packet;
+                    packet.id = 100000 * epoch + 1000 * rank + i;
+                    packet.weight = 0.25 + i;
+                    packet.timeLeft = 0.5 + epoch;
+                    outgoing.push_back(packet);
+                }
+                auto key = outgoing.SourceLkey(&handler, handler.SupportsPersistentSendSourceRegistration());
+                const size_t first = handler.TransferParticlePrefix(outgoing.data(), outgoing.size(), key);
+                require(first == handler.peer_buffsize, "initial prefix did not fill ring");
+                outgoing.Consume(first);
+                MPI_Barrier(MPI_COMM_WORLD);
+                require(handler.TransferParticlePrefix(outgoing.data(), outgoing.size(), key) == 0,
+                        "full ring must apply backpressure");
+                MPI_Barrier(MPI_COMM_WORLD);
+                size_t received = 0, polls = 0;
+                const double deadline = MPI_Wtime() + 30;
+                while(not outgoing.empty() || received < count) {
+                    if(not outgoing.empty()) {
+                        key = outgoing.SourceLkey(&handler, handler.SupportsPersistentSendSourceRegistration());
+                        outgoing.Consume(handler.TransferParticlePrefix(outgoing.data(), outgoing.size(), key));
+                    }
+                    // Deliberately delay one consumer; other ranks must keep
