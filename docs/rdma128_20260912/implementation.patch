+using Handler = STORM::RankHandler2<Vector3D, int>;
+using Packet = Handler::MCParticle;
+static void require(bool ok, const char *message) {
+    if(!ok) throw std::runtime_error(message);
+}
+template<class F> static void rejects(F operation) {
+    bool caught = false;
+    try { operation(); } catch(const std::runtime_error &) { caught = true; }
+    require(caught, "forbidden operation was accepted");
+}
+int main(int argc, char **argv) {
+    MPI_Init(&argc, &argv);
+    int rank, size;
+    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
+    MPI_Comm_size(MPI_COMM_WORLD, &size);
