+def parse_slurm_time_limit(value: Any) -> int:
+    """Parse a Slurm time limit into seconds.
+
+    Slurm accepts ``minutes``, ``minutes:seconds``, ``hours:minutes:seconds``,
+    and the corresponding ``days-...`` forms.
+    """
+    text = str(value).strip()
+    if not text:
+        raise ThunderError("SLURM_TIME_LIMIT must not be empty")
+
+    days = 0
+    clock = text
+    has_days = "-" in text
+    if has_days:
+        day_text, clock = text.split("-", 1)
+        if not day_text.isdigit():
+            raise ThunderError(f"Invalid SLURM_TIME_LIMIT: {text!r}")
+        days = int(day_text)
+
+    fields = clock.split(":")
+    if not all(field.isdigit() for field in fields):
+        raise ThunderError(f"Invalid SLURM_TIME_LIMIT: {text!r}")
+    numbers = [int(field) for field in fields]
+    if has_days:
+        if len(numbers) == 1:
+            hours, minutes, seconds = numbers[0], 0, 0
+        elif len(numbers) == 2:
+            hours, minutes, seconds = numbers[0], numbers[1], 0
+        elif len(numbers) == 3:
+            hours, minutes, seconds = numbers
+        else:
+            raise ThunderError(f"Invalid SLURM_TIME_LIMIT: {text!r}")
+    else:
+        if len(numbers) == 1:
+            hours, minutes, seconds = 0, numbers[0], 0
+        elif len(numbers) == 2:
+            hours, minutes, seconds = 0, numbers[0], numbers[1]
+        elif len(numbers) == 3:
+            hours, minutes, seconds = numbers
+        else:
+            raise ThunderError(f"Invalid SLURM_TIME_LIMIT: {text!r}")
+
+    if minutes >= 60 or seconds >= 60:
+        raise ThunderError(f"Invalid SLURM_TIME_LIMIT: {text!r}")
+    total = days * 86400 + hours * 3600 + minutes * 60 + seconds
+    if total <= 0:
+        raise ThunderError("SLURM_TIME_LIMIT must be positive")
+    return total
+
+
