+// Distance to the closest inward-facing cell plane, for random-walk radius
+// selection. This includes all faces, even transverse faces in slab mode.
+template<typename ParticleT, typename PointT>
+STORM_GPU_INLINE_FUNCTION
+double MinimumFaceDistance(const ParticleT &particle, const FlatGridView<PointT> &grid)
+{
+    const std::size_t cell = static_cast<std::size_t>(particle.cellIndex);
+    const std::size_t end = grid.cellFaceOffsets[cell + 1];
+    std::size_t face = grid.cellFaceOffsets[cell];
+    double radius = DBL_MAX;
+#if defined(STORM_CPU_VECTOR_INTERSECTION) && defined(__AVX2__) && !defined(STORM_WITH_GPU)
+    if constexpr(std::is_same<decltype(particle.location.x), double>::value &&
+                 std::is_same<decltype(PointT::x), double>::value)
+    {
+        const __m256d px = _mm256_set1_pd(particle.location.x);
+        const __m256d py = _mm256_set1_pd(particle.location.y);
+        const __m256d pz = _mm256_set1_pd(particle.location.z);
+        __m256d nearest = _mm256_set1_pd(DBL_MAX);
+        for(; end - face >= 4; face += 4)
+        {
+            const PointT *n = grid.normals + face;
+            const __m256d nx = grid.normalX ? _mm256_loadu_pd(grid.normalX + face) :
+                _mm256_setr_pd(n[0].x, n[1].x, n[2].x, n[3].x);
+            const __m256d ny = grid.normalY ? _mm256_loadu_pd(grid.normalY + face) :
+                _mm256_setr_pd(n[0].y, n[1].y, n[2].y, n[3].y);
+            const __m256d nz = grid.normalZ ? _mm256_loadu_pd(grid.normalZ + face) :
+                _mm256_setr_pd(n[0].z, n[1].z, n[2].z, n[3].z);
+            const __m256d plane = _mm256_add_pd(_mm256_add_pd(_mm256_mul_pd(px, nx),
+                _mm256_mul_pd(py, ny)), _mm256_mul_pd(pz, nz));
+            const __m256d distance = _mm256_sub_pd(plane, _mm256_loadu_pd(grid.facePlaneOffsets + face));
+            // Match the scalar comparison's treatment of NaN distances.
+            nearest = _mm256_blendv_pd(nearest, distance, _mm256_cmp_pd(distance, nearest, _CMP_LT_OQ));
+        }
+        alignas(32) double distances[4];
+        _mm256_store_pd(distances, nearest);
+        for(double distance : distances)
+            if(distance < radius) radius = distance;
+    }
+#endif
+    for(; face < end; ++face)
+    {
+        const PointT &normal = grid.normals[face];
+        const double distance = particle.location.x * normal.x + particle.location.y * normal.y +
+                                particle.location.z * normal.z - grid.facePlaneOffsets[face];
+        if(distance < radius) radius = distance;
+    }
+    return radius;
+}
+
