CMAKE=cmake
PYTHON=python3

MAIN_DIRECTORY=..
DIRECTORY=${MAIN_DIRECTORY}/source/3D/GeometryCommon/pybind
BUILD_DIR=${DIRECTORY}/build
TESTS_DIR=${DIRECTORY}/tests
MODULE_EXTENSION=.cpython-39-x86_64-linux-gnu.so

MAT33_MODULE_NAME=mat33
MAT33_TEST_FILE_NAME=Mat33.py

MAT44_MODULE_NAME=mat44
MAT44_TEST_FILE_NAME=Mat44.py

VECTOR3D_MODULE_NAME=vector3D
VECTOR3D_TEST_FILE_NAME=Vector3D.py

FACE_MODULE_NAME=face
FACE_TEST_FILE_NAME=Face.py

TETRAHEDRON_MODULE_NAME=tetrahedron
TETRAHEDRON_TEST_FILE_NAME=Tetrahedron.py

LOG_FILE=log

prepare:
	@rm -f ${LOG_FILE}
	@touch ${LOG_FILE}

build_prepare: prepare
	@mkdir -p ${BUILD_DIR}

test_mat33: build_prepare
	@rm -f ${TESTS_DIR}/${MAT33_MODULE_NAME}${MODULE_EXTENSION} ${BUILD_DIR}/${MAT33_MODULE_NAME}${MODULE_EXTENSION}
	@${CMAKE} -S ${DIRECTORY} -B ${BUILD_DIR} -DBIND_MAT33=true &>> ${LOG_FILE}
	@${CMAKE} --build ${BUILD_DIR} &>> ${LOG_FILE}
	@cp ${BUILD_DIR}/${MAT33_MODULE_NAME}${MODULE_EXTENSION} ${TESTS_DIR}
	@${PYTHON} ${TESTS_DIR}/${MAT33_TEST_FILE_NAME}

test_mat44: build_prepare
	@rm -f ${TESTS_DIR}/${MAT44_MODULE_NAME}${MODULE_EXTENSION} ${BUILD_DIR}/${MAT44_MODULE_NAME}${MODULE_EXTENSION}
	@${CMAKE} -S ${DIRECTORY} -B ${BUILD_DIR} -DBIND_MAT44=true &>> ${LOG_FILE}
	@${CMAKE} --build ${BUILD_DIR} &>> ${LOG_FILE}
	@cp ${BUILD_DIR}/${MAT44_MODULE_NAME}${MODULE_EXTENSION} ${TESTS_DIR}
	@${PYTHON} ${TESTS_DIR}/${MAT44_TEST_FILE_NAME}

test_vector3D: build_prepare
	@rm -f ${TESTS_DIR}/${VECTOR3D_MODULE_NAME}${MODULE_EXTENSION} ${BUILD_DIR}/${VECTOR3D_MODULE_NAME}${MODULE_EXTENSION}
	@${CMAKE} -S ${DIRECTORY} -B ${BUILD_DIR} -DBIND_VECTOR3D=true &>> ${LOG_FILE}
	@${CMAKE} --build ${BUILD_DIR} &>> ${LOG_FILE}
	@cp ${BUILD_DIR}/${VECTOR3D_MODULE_NAME}${MODULE_EXTENSION} ${TESTS_DIR}
	@${PYTHON} ${TESTS_DIR}/${VECTOR3D_TEST_FILE_NAME}

test_face: build_prepare
	@rm -f ${TESTS_DIR}/${FACE_MODULE_NAME}${MODULE_EXTENSION} ${BUILD_DIR}/${FACE_MODULE_NAME}${MODULE_EXTENSION}
	@${CMAKE} -S ${DIRECTORY} -B ${BUILD_DIR} -DBIND_FACE=true &>> ${LOG_FILE}
	@${CMAKE} --build ${BUILD_DIR} &>> ${LOG_FILE}
	@cp ${BUILD_DIR}/${FACE_MODULE_NAME}${MODULE_EXTENSION} ${TESTS_DIR}
	@${PYTHON} ${TESTS_DIR}/${FACE_TEST_FILE_NAME}

test_tetrahedron: build_prepare
	@rm -f ${TESTS_DIR}/${TETRAHEDRON_MODULE_NAME}${MODULE_EXTENSION} ${BUILD_DIR}/${TETRAHEDRON_MODULE_NAME}${MODULE_EXTENSION}
	@${CMAKE} -S ${DIRECTORY} -B ${BUILD_DIR} -DBIND_TETRAHEDRON=true &>> ${LOG_FILE}
	@${CMAKE} --build ${BUILD_DIR} &>> ${LOG_FILE}
	@cp ${BUILD_DIR}/${TETRAHEDRON_MODULE_NAME}${MODULE_EXTENSION} ${TESTS_DIR}
	@${PYTHON} ${TESTS_DIR}/${TETRAHEDRON_TEST_FILE_NAME}

test_all: test_mat33 test_vector3D test_face test_tetrahedron

rich:
	@rm -rf ${MAIN_DIRECTORY}/runs/sedov2d_test
	@cp -r ${MAIN_DIRECTORY}/tests/sedov2d_test ${MAIN_DIRECTORY}/runs
	cd ${MAIN_DIRECTORY}
	@${PYTHON} -m compilation intelRelease --test_name=sedov2d_test
	. ${MAIN_DIRECTORY}/build/intelRelease rich