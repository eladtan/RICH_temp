    "cmake.configureOnOpen": true,

    // maor:
    "git.autofetch": true,
    "[python]": {
        "editor.formatOnType": true
    },
    "editor.fontSize": 18,
    "files.autoSave": "afterDelay",
    "editor.cursorSmoothCaretAnimation": "on",
    "terminal.integrated.enableMultiLinePasteWarning": false,
    "explorer.confirmDelete": false,
    "workbench.editor.closeOnFileDelete": true,
    "workbench.colorTheme": "Atom One Dark",

    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "variable.other.property",
                "settings": {
                    "fontStyle": "italic",
                    "foreground": "#E06C75"
                }
            },
            {
                "scope": "entity.name.type",
                "settings": {
                    "foreground": "#6ab479"
                }
            },
            {
                "scope": "entity.name.function.macro",
                "settings": {
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "entity.name.function.member.cpp",
                "settings": {
                    "foreground": "#2596be",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "variable.language.this.cpp, variable.language.this.java",
                "settings": {
                    "foreground": "#EA99A2",
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "entity.name.namespace",
                "settings": {
                    "fontStyle": "bold",
                    "foreground": "#59aaaf"
                }
            },
            {
                "scope": "entity.name.function.macro",
                "settings": {
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "variable.other.readwrite, entity.name.variable, variable.other.constant, variable.other.local.cpp",
                "settings": {
                    "foreground": "#a2acb9"
                }
            },
            {
                "scope": "variable.other.constant",
                "settings": {
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "entity.name.function.definition.cpp",
                "settings": {
                    "fontStyle": "bold"
                }
            },
            {
                "scope": "support.type.built-in.posix-reserved.cpp",
                "settings": {
                    "foreground": "#1dbbcf"
                }
            }
        ]        
    },
    "C_Cpp.files.exclude": 
    {
        "*.h5": true,
        "*.txt": true,
        "*.vtu": true,
        "**/.vscode": true,
        "**/.vs": true
    }
}